class AdaptiveEngine:
    order = ["Easy", "Medium", "Hard"]

    def __init__(self, time_thresholds=None):
        self.time_thresholds = time_thresholds or {"Easy":8.0, "Medium":12.0, "Hard":20.0}

    def next_level(self, history, current):
        if not history:
            return current
        last3 = history[-3:]
        last2 = history[-2:]
        def up(d):
            i = self.order.index(d); return self.order[min(i+1, 2)]
        def down(d):
            i = self.order.index(d); return self.order[max(i-1, 0)]
        if len(last3)==3 and all(r.get('correct') for r in last3):
            avg_t = sum(r['time_taken'] for r in last3)/3.0
            if avg_t < self.time_thresholds.get(current, 9999):
                return up(current)
        if len(last2)==2 and sum(1 for r in last2 if not r.get('correct'))>=2:
            return down(current)
        return current
